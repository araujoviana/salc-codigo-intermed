@ Programa: aritmetica
@ Testa todos os operadores aritmeticos: +, -, *, /, e menos unario
@ Instrucoes MEPA exercidas: SOMA, SUBT, MULT, DIVI, CRCT 0 + SUBT (unario)
@
@ Entrada: dois inteiros a e b (ex: a=10, b=3)
@ Saida:   a+b=13, a-b=7, a*b=30, a/b=3, -a=-10

module aritmetica;

globals
    a: int;
    b: int;
    res: int;

proc main()
start
    scan(a);
    scan(b);

    res := a + b;
    print(res);

    res := a - b;
    print(res);

    res := a * b;
    print(res);

    res := a / b;
    print(res);

    res := -a;
    print(res);
end
