@ Programa: for_passo
@ Testa o comando for com passo positivo e negativo
@ Instrucoes MEPA exercidas: padrao 4-rotulos do for
@   - Passo positivo: CMMEG (ctrl <= limite), SOMA (incremento)
@   - Passo negativo: CMMAG (ctrl >= limite), SUBT (decremento)
@
@ Loop crescente  (i de 1 a 5, passo 1):  soma = 1+2+3+4+5 = 15
@ Loop decrescente (j de 5 a 1, passo -1): soma = 5+4+3+2+1 = 15
@ Saida: 15, 15

module for_passo;

globals
    i: int;
    soma: int;

proc main()
locals
    j: int;
start
    @ Passo positivo: i de 1 a 5
    soma := 0;
    for i := 1 to 5 step 1 do
    start
        soma := soma + i;
    end;
    print(soma);

    @ Passo negativo: j de 5 ate 1
    soma := 0;
    for j := 5 to 1 step -1 do
    start
        soma := soma + j;
    end;
    print(soma);
end
